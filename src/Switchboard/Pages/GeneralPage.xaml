<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Switchboard.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Switchboard"
    xmlns:controls="using:Switchboard.Controls"
    IsTabStop="False">

    <StackPanel Spacing="4">
        <TextBlock Text="General" Style="{StaticResource PageTitleStyle}" />

        <controls:SettingsCard Header="Start with Windows" Description="Open InputFlip when you sign in, so its shortcuts work right away." Glyph="&#xE7E8;">
            <controls:SettingsCard.Action>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                    OnContent="On"
                    OffContent="Off"
                    MinWidth="0"
                    AutomationProperties.Name="Start with Windows" />
            </controls:SettingsCard.Action>
        </controls:SettingsCard>
        <TextBlock
            Text="{x:Bind ViewModel.GeneralMessage, Mode=OneWay}"
            Visibility="{x:Bind local:Ui.VisibleText(ViewModel.GeneralMessage), Mode=OneWay}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Margin="2,0,0,4" />

        <controls:SettingsCard Header="App theme" Description="Light or dark, or the same as Windows." Glyph="&#xE790;">
            <controls:SettingsCard.Action>
                <ComboBox SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" MinWidth="200" AutomationProperties.Name="App theme">
                    <x:String>Use Windows setting</x:String>
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                </ComboBox>
            </controls:SettingsCard.Action>
        </controls:SettingsCard>

        <controls:SettingsCard Header="Keep the window on top" Description="InputFlip stays above other windows. Same as the pin in its title bar." Glyph="&#xE718;">
            <controls:SettingsCard.Action>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.AlwaysOnTop, Mode=TwoWay}"
                    OnContent="On"
                    OffContent="Off"
                    MinWidth="0"
                    AutomationProperties.Name="Keep the window on top" />
            </controls:SettingsCard.Action>
        </controls:SettingsCard>

        <controls:SettingsCard Header="Move the mouse out of the way" Description="When a monitor switches from this PC to another device with the mouse on it, the mouse moves to InputFlip's window. Switching back to this PC puts it back." Glyph="&#xE962;">
            <controls:SettingsCard.Action>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.MoveMouse, Mode=TwoWay}"
                    OnContent="On"
                    OffContent="Off"
                    MinWidth="0"
                    AutomationProperties.Name="Move the mouse out of the way" />
            </controls:SettingsCard.Action>
        </controls:SettingsCard>

        <TextBlock Text="Tray and notes" Style="{StaticResource SectionHeaderStyle}" />
        <controls:SettingsCard Header="Icon by the clock" Description="Click it to open InputFlip; right-click it for scenes and inputs. It shows on the main display's taskbar." Glyph="&#xE7C4;">
            <controls:SettingsCard.Action>
                <ToggleSwitch IsOn="{x:Bind ViewModel.ShowTrayIcon, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0" AutomationProperties.Name="Icon by the clock" />
            </controls:SettingsCard.Action>
        </controls:SettingsCard>
        <controls:SettingsCard Header="Closing the window keeps InputFlip running" Description="The close button hides the window instead of quitting, so shortcuts and rules keep working. Quit from the tray icon's menu." Glyph="&#xE8BB;">
            <controls:SettingsCard.Action>
                <ToggleSwitch IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.ShowTrayIcon, Mode=OneWay}" OnContent="On" OffContent="Off" MinWidth="0" AutomationProperties.Name="Closing the window keeps InputFlip running" />
            </controls:SettingsCard.Action>
        </controls:SettingsCard>
        <controls:SettingsCard Header="Show a note after a switch" Description="A short note like PS5 on MSI at the bottom of a screen you can still see, after a shortcut, scene, rule or command switches a monitor." Glyph="&#xE8BD;">
            <controls:SettingsCard.Action>
                <ToggleSwitch IsOn="{x:Bind ViewModel.ShowToasts, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0" AutomationProperties.Name="Show a note after a switch" />
            </controls:SettingsCard.Action>
        </controls:SettingsCard>

        <TextBlock Text="Advanced" Style="{StaticResource SectionHeaderStyle}" />
        <controls:SettingsCard Header="Settings file" Description="{x:Bind ViewModel.SettingsFilePath}" Glyph="&#xE943;">
            <controls:SettingsCard.Action>
                <Button Content="Edit" Command="{x:Bind ViewModel.EditSettingsFileCommand}" AutomationProperties.Name="Edit the settings file" ToolTipService.ToolTip="Everything here is saved in this file. Changes you save there apply right away." />
            </controls:SettingsCard.Action>
        </controls:SettingsCard>
    </StackPanel>
</UserControl>
