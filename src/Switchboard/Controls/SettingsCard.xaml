<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Switchboard.Controls.SettingsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Switchboard"
    IsTabStop="False">

    <Border Style="{StaticResource CardStyle}" Padding="16,12" MinHeight="64">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <FontIcon
                Glyph="{x:Bind Glyph, Mode=OneWay}"
                FontSize="20"
                VerticalAlignment="Center"
                Visibility="{x:Bind local:Ui.VisibleText(Glyph), Mode=OneWay}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Header, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock
                    Text="{x:Bind Description, Mode=OneWay}"
                    Style="{StaticResource DescriptionStyle}"
                    Visibility="{x:Bind local:Ui.VisibleText(Description), Mode=OneWay}" />
            </StackPanel>
            <ContentPresenter Grid.Column="2" Content="{x:Bind Action, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
    </Border>
</UserControl>
