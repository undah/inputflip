<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Switchboard.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Switchboard"
    xmlns:controls="using:Switchboard.Controls"
    xmlns:vm="using:Switchboard.ViewModels"
    Title="Set up InputFlip">

    <Grid x:Name="Root" RowDefinitions="Auto,Auto,*,Auto" Background="{ThemeResource IfBackgroundBrush}">
        <Grid x:Name="TitleArea" Height="48" Background="Transparent" ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="16,0,0,0">
            <Image Source="ms-appx:///Assets/Switchboard.ico" Width="16" Height="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Grid.Column="1" Text="Set up InputFlip" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Padding="40,8,40,4" Spacing="4">
            <TextBlock x:Name="StepText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="StepTitle" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="StepIntro" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="2" IsTabStop="False">
            <Grid Padding="40,16,40,24">
                <!-- Step: monitors found -->
                <StackPanel x:Name="MonitorsStep" Spacing="8">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Monitors}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MonitorEditViewModel">
                                <Border Style="{StaticResource CardStyle}" Padding="16,12" Visibility="{x:Bind local:Ui.Visible(IsConnected), Mode=OneWay}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="20" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource DescriptionStyle}" />
                                            <TextBlock Text="{x:Bind Details, Mode=OneWay}" Style="{StaticResource DescriptionStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind local:Ui.Visible(IsAnswering), Mode=OneWay}" AutomationProperties.Name="Answers" />
                                            <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind local:Ui.Visible(IsNotAnswering), Mode=OneWay}" AutomationProperties.Name="Not answering" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoMonitorsText" Text="No monitors found yet. InputFlip is still looking." Style="{StaticResource DescriptionStyle}" />
                    <Button Click="CheckAgain_Click" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Check again" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Step: name inputs and pick icons -->
                <ItemsControl x:Name="NamesStep" ItemsSource="{x:Bind ViewModel.Monitors}" IsTabStop="False" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="20" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MonitorEditViewModel">
                            <StackPanel Spacing="8" Visibility="{x:Bind local:Ui.Visible(IsConnected), Mode=OneWay}">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                                <controls:InputListEditor Monitor="{x:Bind}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Step: screens-off suggestion (only when a monitor fits the pattern) -->
                <ItemsControl x:Name="ScreensOffStep" ItemsSource="{x:Bind Suggestions}" IsTabStop="False" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScreensOffSuggestionViewModel">
                            <Border Style="{StaticResource CardStyle}" Padding="16">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{x:Bind Title}" />
                                        <TextBlock Text="{x:Bind Explanation}" Style="{StaticResource DescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsOn, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind ToggleName}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Step: shortcuts (the Shortcuts settings page, without its title) -->
                <ContentControl x:Name="ShortcutsStep" IsTabStop="False" HorizontalContentAlignment="Stretch" Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>

        <Grid
            Grid.Row="3"
            Padding="24,16"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Button x:Name="SkipButton" Content="Skip setup" Click="Skip_Click" ToolTipService.ToolTip="Use what InputFlip found. You can change everything later in Settings." />
            <Button x:Name="BackButton" Grid.Column="1" Content="Back" Click="Back_Click" MinWidth="96" />
            <Button x:Name="NextButton" Grid.Column="2" Content="Next" Click="Next_Click" MinWidth="96" Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
