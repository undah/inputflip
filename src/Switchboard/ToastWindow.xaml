<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Switchboard.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="InputFlip">

    <!-- The note after a switch: "PS5 / MSI G27CQ4". It doesn't take focus; a click hides it. -->
    <Grid
        x:Name="Root"
        Background="{ThemeResource IfToastBackgroundBrush}"
        BorderBrush="{ThemeResource IfStrokeBrush}"
        BorderThickness="1"
        Padding="12,10"
        ColumnDefinitions="Auto,*"
        ColumnSpacing="12"
        AutomationProperties.AccessibilityView="Raw">
        <Border Width="40" Height="40" CornerRadius="12" Background="{ThemeResource IfCoralBrush}" VerticalAlignment="Center">
            <FontIcon x:Name="Glyph" FontSize="20" Foreground="{ThemeResource IfOnCoralBrush}" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource IfTextBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="DetailText" FontSize="12" Foreground="{ThemeResource IfTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</Window>
