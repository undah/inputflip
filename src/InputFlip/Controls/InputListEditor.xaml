<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InputFlip.Controls.InputListEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InputFlip"
    xmlns:vm="using:InputFlip.ViewModels"
    IsTabStop="False">

    <Border Style="{StaticResource CardStyle}" Padding="12,8">
        <ItemsControl ItemsSource="{x:Bind Monitor.Inputs, Mode=OneWay}" IsTabStop="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InputEditViewModel">
                    <Grid ColumnSpacing="8" Padding="0,4" Opacity="{x:Bind local:Ui.ShownOpacity(IsShown), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <DropDownButton
                            AutomationProperties.Name="{x:Bind IconBoxName, Mode=OneWay}"
                            ToolTipService.ToolTip="Icon"
                            Padding="10,6,8,6">
                            <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}" FontSize="16" />
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <RadioMenuFlyoutItem Text="PC" GroupName="Icon" Command="{x:Bind SetIconCommand}" CommandParameter="pc" IsChecked="{x:Bind local:Ui.IsIcon(IconKey, 'pc'), Mode=OneWay}">
                                        <RadioMenuFlyoutItem.Icon><FontIcon Glyph="&#xE977;" /></RadioMenuFlyoutItem.Icon>
                                    </RadioMenuFlyoutItem>
                                    <RadioMenuFlyoutItem Text="Laptop" GroupName="Icon" Command="{x:Bind SetIconCommand}" CommandParameter="laptop" IsChecked="{x:Bind local:Ui.IsIcon(IconKey, 'laptop'), Mode=OneWay}">
                                        <RadioMenuFlyoutItem.Icon><FontIcon Glyph="&#xE7F8;" /></RadioMenuFlyoutItem.Icon>
                                    </RadioMenuFlyoutItem>
                                    <RadioMenuFlyoutItem Text="Console" GroupName="Icon" Command="{x:Bind SetIconCommand}" CommandParameter="console" IsChecked="{x:Bind local:Ui.IsIcon(IconKey, 'console'), Mode=OneWay}">
                                        <RadioMenuFlyoutItem.Icon><FontIcon Glyph="&#xE7FC;" /></RadioMenuFlyoutItem.Icon>
                                    </RadioMenuFlyoutItem>
                                    <RadioMenuFlyoutItem Text="TV or media player" GroupName="Icon" Command="{x:Bind SetIconCommand}" CommandParameter="tv" IsChecked="{x:Bind local:Ui.IsIcon(IconKey, 'tv'), Mode=OneWay}">
                                        <RadioMenuFlyoutItem.Icon><FontIcon Glyph="&#xE714;" /></RadioMenuFlyoutItem.Icon>
                                    </RadioMenuFlyoutItem>
                                    <RadioMenuFlyoutItem Text="Plain monitor" GroupName="Icon" Command="{x:Bind SetIconCommand}" CommandParameter="display" IsChecked="{x:Bind local:Ui.IsIcon(IconKey, 'display'), Mode=OneWay}">
                                        <RadioMenuFlyoutItem.Icon><FontIcon Glyph="&#xE7F4;" /></RadioMenuFlyoutItem.Icon>
                                    </RadioMenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <TextBox
                            Grid.Column="1"
                            Text="{x:Bind Name, Mode=TwoWay}"
                            PlaceholderText="{x:Bind PortName, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind NameBoxName, Mode=OneWay}"
                            VerticalAlignment="Center" />

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind PortLine, Mode=OneWay}" Style="{StaticResource DescriptionStyle}" />
                            <TextBlock
                                Text="Showing now"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Visibility="{x:Bind local:Ui.Visible(IsCurrent), Mode=OneWay}" />
                        </StackPanel>

                        <CheckBox
                            Grid.Column="3"
                            Content="Show"
                            MinWidth="0"
                            IsChecked="{x:Bind IsShown, Mode=TwoWay}"
                            AutomationProperties.Name="{x:Bind ShowBoxName, Mode=OneWay}"
                            ToolTipService.ToolTip="Show this input in the InputFlip window"
                            VerticalAlignment="Center" />

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button
                                Style="{StaticResource IconButtonStyle}"
                                Width="32"
                                Command="{x:Bind MoveUpCommand}"
                                IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind MoveUpName, Mode=OneWay}"
                                ToolTipService.ToolTip="Move up">
                                <FontIcon Glyph="&#xE70E;" FontSize="12" />
                            </Button>
                            <Button
                                Style="{StaticResource IconButtonStyle}"
                                Width="32"
                                Command="{x:Bind MoveDownCommand}"
                                IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind MoveDownName, Mode=OneWay}"
                                ToolTipService.ToolTip="Move down">
                                <FontIcon Glyph="&#xE70D;" FontSize="12" />
                            </Button>
                            <Button
                                Style="{StaticResource IconButtonStyle}"
                                Width="32"
                                Command="{x:Bind RemoveCommand}"
                                IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind RemoveName, Mode=OneWay}"
                                ToolTipService.ToolTip="Remove. Only for inputs you added: the ones the monitor lists can be hidden instead.">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
