<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>InputFlip</RootNamespace>
    <AssemblyName>InputFlip</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\InputFlip.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>InputFlip</Product>
    <Description>Switches your monitor's input over DDC/CI</Description>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, with the Windows App SDK runtime copied next to the exe: no MSIX, no separate runtime install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Despite the name, no MSIX: without it, dotnet publish leaves out the app's compiled XAML (.xbf, .pri)
         and the published app fails at start with "XAML parsing failed". -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.cs has Main: it reads the command line and runs Velopack's install hooks before the UI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- One framework and one runtime per platform, so the extra folder levels only add length.
         The XAML compiler fails on paths over 260 characters when the repo sits in a deep folder. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- Release builds carry the .NET runtime too, so friends don't need .NET installed. See scripts/build-installer.ps1. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- 1.8 rather than 2.x: the stable line this code was written against. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Installer and its install/uninstall hooks. Keep in step with the vpk tool version in scripts/build-installer.ps1. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\InputFlip.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Where the update button looks by default; scripts/build-installer.ps1 passes its releases folder. -->
  <ItemGroup Condition="'$(UpdateSource)' != ''">
    <AssemblyMetadata Include="UpdateSource" Value="$(UpdateSource)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InputFlip.Core\InputFlip.Core.csproj" />
  </ItemGroup>

</Project>
