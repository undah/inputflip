<?xml version="1.0" encoding="utf-8"?>
<!-- InputFlip's look ("Tiles", picked by the owner on 2026-11-21): cool near-black or white, inputs as big tiles, the input
     showing now in clean blue (the owner swapped coral for blue on 2026-11-22). Every color is a theme resource, so light and dark follow Windows or the theme picked
     in Settings. The blue also replaces the Windows accent color for standard controls (toggles, sliders, buttons). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="IfBackgroundColor">#10141B</Color>
            <SolidColorBrush x:Key="IfBackgroundBrush" Color="#10141B" />
            <SolidColorBrush x:Key="IfSurfaceBrush" Color="#1A202B" />
            <SolidColorBrush x:Key="IfSurfaceRaisedBrush" Color="#212836" />
            <SolidColorBrush x:Key="IfStrokeBrush" Color="#2B3343" />
            <SolidColorBrush x:Key="IfTextBrush" Color="#EEF2F8" />
            <SolidColorBrush x:Key="IfTextSecondaryBrush" Color="#9AA6B8" />
            <SolidColorBrush x:Key="IfIconBrush" Color="#8FB4FF" />
            <SolidColorBrush x:Key="IfAccentBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="IfOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="IfOnAccentSecondaryBrush" Color="#DCE7FF" />
            <SolidColorBrush x:Key="IfHoverOverlayBrush" Color="#16FFFFFF" />
            <SolidColorBrush x:Key="IfPressedOverlayBrush" Color="#0C000000" />
            <SolidColorBrush x:Key="IfToastBackgroundBrush" Color="#212836" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="IfBackgroundColor">#F7F9FC</Color>
            <SolidColorBrush x:Key="IfBackgroundBrush" Color="#F7F9FC" />
            <SolidColorBrush x:Key="IfSurfaceBrush" Color="#EDF2F9" />
            <SolidColorBrush x:Key="IfSurfaceRaisedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="IfStrokeBrush" Color="#DCE3EE" />
            <SolidColorBrush x:Key="IfTextBrush" Color="#141A24" />
            <SolidColorBrush x:Key="IfTextSecondaryBrush" Color="#5A6678" />
            <SolidColorBrush x:Key="IfIconBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="IfAccentBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="IfOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="IfOnAccentSecondaryBrush" Color="#DCE7FF" />
            <SolidColorBrush x:Key="IfHoverOverlayBrush" Color="#0D141A24" />
            <SolidColorBrush x:Key="IfPressedOverlayBrush" Color="#18141A24" />
            <SolidColorBrush x:Key="IfToastBackgroundBrush" Color="#FFFFFF" />
        </ResourceDictionary>
        <!-- Windows' high-contrast themes win over the brand: system colors only. -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="IfBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="IfSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="IfSurfaceRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="IfStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="IfTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="IfTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="IfIconBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="IfAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="IfOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="IfOnAccentSecondaryBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="IfHoverOverlayBrush" Color="Transparent" />
            <SolidColorBrush x:Key="IfPressedOverlayBrush" Color="Transparent" />
            <SolidColorBrush x:Key="IfToastBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Blue instead of the Windows accent color in standard controls. Light mode fills with the darker shades
         (white text on them), dark mode with the lighter ones (black text). -->
    <Color x:Key="SystemAccentColor">#2563EB</Color>
    <Color x:Key="SystemAccentColorLight1">#3D78F0</Color>
    <Color x:Key="SystemAccentColorLight2">#5B8DF5</Color>
    <Color x:Key="SystemAccentColorLight3">#84AAF8</Color>
    <Color x:Key="SystemAccentColorDark1">#1D4FD0</Color>
    <Color x:Key="SystemAccentColorDark2">#1A44B0</Color>
    <Color x:Key="SystemAccentColorDark3">#163A94</Color>

    <x:String x:Key="MonoFont">Cascadia Mono, Consolas</x:String>
    <x:String x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</x:String>

    <!-- An input in the main window: a big tile. The fill carries blue for the input showing now; the overlay on top
         shows hover and pressed on blue tiles and plain ones alike. Switching between the two styles only changes
         Background and Foreground. -->
    <ControlTemplate x:Key="TileTemplate" TargetType="Button">
        <Grid x:Name="Root" CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource IfHoverOverlayBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource IfPressedOverlayBrush}" />
                            <Setter Target="ContentPresenter.Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="ContentPresenter.Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Fill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="Overlay" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter
                x:Name="ContentPresenter"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Padding="{TemplateBinding Padding}"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                Foreground="{TemplateBinding Foreground}"
                AutomationProperties.AccessibilityView="Raw" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="TileStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource TileTemplate}" />
        <Setter Property="Background" Value="{ThemeResource IfSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource IfStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource IfTextBrush}" />
        <Setter Property="Padding" Value="12,10,10,10" />
        <Setter Property="MinHeight" Value="96" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="CurrentTileStyle" TargetType="Button" BasedOn="{StaticResource TileStyle}">
        <Setter Property="Background" Value="{ThemeResource IfAccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource IfAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource IfOnAccentBrush}" />
    </Style>

    <!-- The icon on a tile: light blue on plain tiles, the tile's text color on blue. -->
    <Style x:Key="TileIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource IfIconBrush}" />
    </Style>

    <Style x:Key="CurrentTileIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource IfOnAccentBrush}" />
    </Style>

    <!-- A scene: a pill. Blue when every monitor it switches shows its input. -->
    <Style x:Key="SceneChipStyle" TargetType="Button" BasedOn="{StaticResource TileStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="CurrentSceneChipStyle" TargetType="Button" BasedOn="{StaticResource SceneChipStyle}">
        <Setter Property="Background" Value="{ThemeResource IfAccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource IfAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource IfOnAccentBrush}" />
    </Style>

    <!-- Small borderless icon buttons: title bar, reorder arrows. Subtle fill on hover, faded when disabled. -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Foreground="{TemplateBinding Foreground}"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A settings card: icon, title and description on the left, a control on the right. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource IfSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource IfStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- Group label above a set of cards. -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="1,24,0,6" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,4,0,8" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>

    <Style x:Key="DescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource IfTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The name of a monitor above its tiles. -->
    <Style x:Key="MonitorHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource IfTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
</ResourceDictionary>
