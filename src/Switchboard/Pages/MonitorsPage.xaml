<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Switchboard.Pages.MonitorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Switchboard"
    xmlns:controls="using:Switchboard.Controls"
    xmlns:vm="using:Switchboard.ViewModels"
    IsTabStop="False">

    <StackPanel Spacing="4">
        <TextBlock Text="Monitors" Style="{StaticResource PageTitleStyle}" />
        <TextBlock
            Text="Names and icons show in the InputFlip window. Monitors and inputs appear in the order listed here."
            Style="{StaticResource DescriptionStyle}"
            Margin="0,0,0,12" />

        <ItemsControl x:Name="MonitorList" ItemsSource="{x:Bind ViewModel.Monitors}" IsTabStop="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MonitorEditViewModel">
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="{x:Bind IsConnected, Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                        Tag="{x:Bind Id}">
                        <Expander.Header>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Padding="0,12">
                                <FontIcon Glyph="&#xE7F4;" FontSize="20" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource DescriptionStyle}" />
                                    <TextBlock Text="{x:Bind Details, Mode=OneWay}" Style="{StaticResource DescriptionStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Grid>
                        </Expander.Header>

                        <StackPanel Spacing="12" Padding="4,4,4,8">
                            <InfoBar
                                IsOpen="{x:Bind local:Ui.HasText(Suggestion), Mode=OneWay}"
                                IsClosable="False"
                                Severity="Informational"
                                Title="Suggestion"
                                Message="{x:Bind Suggestion, Mode=OneWay}">
                                <InfoBar.ActionButton>
                                    <Button Content="Turn it on" Command="{x:Bind ApplySuggestionCommand}" HorizontalAlignment="Left" />
                                </InfoBar.ActionButton>
                            </InfoBar>

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="24">
                                <TextBox
                                    Header="Name in InputFlip"
                                    Text="{x:Bind Nickname, Mode=TwoWay}"
                                    PlaceholderText="{x:Bind ModelName, Mode=OneWay}"
                                    MaxWidth="360"
                                    HorizontalAlignment="Stretch" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    Header="Show in InputFlip"
                                    IsOn="{x:Bind IsShown, Mode=TwoWay}"
                                    MinWidth="0" />
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Order" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind MoveUpCommand}" IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}" AutomationProperties.Name="{x:Bind MoveUpName, Mode=OneWay}" ToolTipService.ToolTip="Move up">
                                            <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind MoveDownCommand}" IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}" AutomationProperties.Name="{x:Bind MoveDownName, Mode=OneWay}" ToolTipService.ToolTip="Move down">
                                            <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Inputs" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level3" Margin="0,8,0,0" />
                            <controls:InputListEditor Monitor="{x:Bind}" />

                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox
                                        x:Name="AddBox"
                                        Header="Add an input by its value"
                                        PlaceholderText="For example 0x1B"
                                        Text="{x:Bind AddValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="220"
                                        KeyDown="AddBox_KeyDown" />
                                    <Button Content="Add" Command="{x:Bind AddCommand}" VerticalAlignment="Bottom" AutomationProperties.Name="Add input" />
                                </StackPanel>
                                <TextBlock
                                    Text="{x:Bind AddError, Mode=OneWay}"
                                    Visibility="{x:Bind local:Ui.VisibleText(AddError), Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    AutomationProperties.LiveSetting="Assertive" />
                                <TextBlock
                                    Text="For an input the monitor doesn't list. Common values: 0x0F DisplayPort 1, 0x10 DisplayPort 2, 0x11 HDMI 1, 0x12 HDMI 2, 0x1B USB-C. Check that it works by clicking it in the InputFlip window."
                                    Style="{StaticResource DescriptionStyle}" />
                            </StackPanel>

                            <StackPanel Spacing="4" Margin="0,8,0,0">
                                <ComboBox
                                    Header="Turn the screens off when switching away from"
                                    ItemsSource="{x:Bind ScreensOffOptions}"
                                    SelectedIndex="{x:Bind ScreensOffIndex, Mode=TwoWay}"
                                    MinWidth="280" />
                                <TextBlock
                                    Text="For a monitor that ignores switch commands while it shows this PC, like the MSI G27CQ4 over DisplayPort. Pick this PC's input: switching away from it then turns all screens off for a few seconds, which makes the monitor listen."
                                    Style="{StaticResource DescriptionStyle}" />
                            </StackPanel>

                            <Button
                                Content="Forget this monitor"
                                Command="{x:Bind ForgetCommand}"
                                Visibility="{x:Bind local:Ui.Visible(IsNotConnected), Mode=OneWay}"
                                ToolTipService.ToolTip="Removes its names, icons and shortcuts from InputFlip. It's added again if you connect it." />
                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
