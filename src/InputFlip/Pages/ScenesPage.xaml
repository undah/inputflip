<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InputFlip.Pages.ScenesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InputFlip"
    xmlns:vm="using:InputFlip.ViewModels"
    IsTabStop="False">

    <StackPanel Spacing="4">
        <TextBlock Text="Scenes" Style="{StaticResource PageTitleStyle}" />
        <TextBlock
            Text="A scene switches several monitors at once, and can set their brightness. Scenes show as buttons at the top of the InputFlip window; give one a shortcut on the Shortcuts page. Running a scene that's already showing goes back to what was on before."
            Style="{StaticResource DescriptionStyle}"
            Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCurrentAsSceneCommand}"
                ToolTipService.ToolTip="Makes a scene from the inputs every shown monitor has on screen now.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8A9;" FontSize="14" />
                    <TextBlock Text="Save what's showing now" />
                </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.AddSceneCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add an empty scene" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock
            Text="No scenes yet. Put your monitors on the inputs you want, then Save what's showing now."
            Visibility="{x:Bind local:Ui.Collapsed(ViewModel.HasScenes), Mode=OneWay}"
            Style="{StaticResource DescriptionStyle}"
            Margin="0,8,0,0" />

        <ItemsControl ItemsSource="{x:Bind ViewModel.Scenes}" IsTabStop="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SceneEditViewModel">
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                        <Expander.Header>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Padding="0,12">
                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="20" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource DescriptionStyle}" />
                                </StackPanel>
                            </Grid>
                        </Expander.Header>

                        <StackPanel Spacing="12" Padding="4,4,4,8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <TextBox Header="Name" Text="{x:Bind Name, Mode=TwoWay}" MaxWidth="360" HorizontalAlignment="Left" MinWidth="240" />
                                <ComboBox Grid.Column="1" Header="Icon" ItemsSource="{x:Bind vm:SceneEditViewModel.IconLabels}" SelectedIndex="{x:Bind IconIndex, Mode=TwoWay}" MinWidth="180" />
                            </Grid>

                            <TextBlock Text="Monitors" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                            <ItemsControl ItemsSource="{x:Bind Steps}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SceneStepEditViewModel">
                                        <Grid ColumnDefinitions="200,Auto,Auto,*" ColumnSpacing="16" Opacity="{x:Bind local:Ui.ShownOpacity(IsConnected), Mode=OneWay}">
                                            <TextBlock Text="{x:Bind MonitorName, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <ComboBox Grid.Column="1" ItemsSource="{x:Bind InputLabels}" SelectedIndex="{x:Bind InputIndex, Mode=TwoWay}" MinWidth="200" AutomationProperties.Name="{x:Bind InputBoxName, Mode=OneWay}" />
                                            <CheckBox Grid.Column="2" Content="Brightness" IsChecked="{x:Bind SetsBrightness, Mode=TwoWay}" MinWidth="0" AutomationProperties.Name="{x:Bind BrightnessBoxName, Mode=OneWay}" />
                                            <Grid Grid.Column="3" ColumnDefinitions="*,40" Visibility="{x:Bind local:Ui.Visible(SetsBrightness), Mode=OneWay}">
                                                <Slider Minimum="0" Maximum="100" StepFrequency="5" Value="{x:Bind Brightness, Mode=TwoWay}" MaxWidth="220" HorizontalAlignment="Left" MinWidth="140" AutomationProperties.Name="Brightness" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind local:Ui.Percent(Brightness), Mode=OneWay}" Style="{StaticResource DescriptionStyle}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button Content="Run it now" Command="{x:Bind RunCommand}" ToolTipService.ToolTip="Switches the monitors as the scene says." />
                                <Button Command="{x:Bind MoveUpCommand}" IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}" AutomationProperties.Name="{x:Bind MoveUpName, Mode=OneWay}" ToolTipService.ToolTip="Move up">
                                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                </Button>
                                <Button Command="{x:Bind MoveDownCommand}" IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}" AutomationProperties.Name="{x:Bind MoveDownName, Mode=OneWay}" ToolTipService.ToolTip="Move down">
                                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                </Button>
                                <Button Command="{x:Bind DeleteCommand}" AutomationProperties.Name="{x:Bind DeleteName, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        <TextBlock Text="Delete" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
