<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Switchboard.Pages.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Switchboard"
    xmlns:controls="using:Switchboard.Controls"
    xmlns:vm="using:Switchboard.ViewModels"
    IsTabStop="False">

    <StackPanel Spacing="4">
        <TextBlock x:Name="PageTitle" Text="Shortcuts" Style="{StaticResource PageTitleStyle}" />
        <TextBlock
            x:Name="PageIntro"
            Text="Shortcuts work anywhere while Switchboard is running, even with its window minimized. Click a shortcut, then press the new keys."
            Style="{StaticResource DescriptionStyle}"
            Margin="0,0,0,8" />

        <TextBlock Text="Switchboard" Style="{StaticResource SectionHeaderStyle}" Margin="1,8,0,6" />
        <controls:SettingsCard Header="{x:Bind ViewModel.ShowShortcut.Title}" Description="{x:Bind ViewModel.ShowShortcut.Description}" Glyph="{x:Bind ViewModel.ShowShortcut.Glyph}">
            <controls:SettingsCard.Action>
                <controls:ShortcutRecorder Item="{x:Bind ViewModel.ShowShortcut}" />
            </controls:SettingsCard.Action>
        </controls:SettingsCard>
        <controls:SettingsCard Header="{x:Bind ViewModel.CycleShortcut.Title}" Description="{x:Bind ViewModel.CycleShortcut.Description}" Glyph="{x:Bind ViewModel.CycleShortcut.Glyph}">
            <controls:SettingsCard.Action>
                <controls:ShortcutRecorder Item="{x:Bind ViewModel.CycleShortcut}" />
            </controls:SettingsCard.Action>
        </controls:SettingsCard>
        <controls:SettingsCard Header="Monitor for the next-input shortcut" Description="Automatic uses the main display, or the first monitor that answers." Glyph="&#xE7F4;">
            <controls:SettingsCard.Action>
                <ComboBox
                    ItemsSource="{x:Bind ViewModel.CycleMonitorOptions}"
                    SelectedIndex="{x:Bind ViewModel.CycleMonitorIndex, Mode=TwoWay}"
                    MinWidth="220"
                    AutomationProperties.Name="Monitor for the next-input shortcut" />
            </controls:SettingsCard.Action>
        </controls:SettingsCard>

        <ItemsControl ItemsSource="{x:Bind ViewModel.InputShortcutGroups}" IsTabStop="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ShortcutGroupViewModel">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl ItemsSource="{x:Bind Items}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShortcutItemViewModel">
                                    <controls:SettingsCard Header="{x:Bind Title, Mode=OneWay}" Description="{x:Bind Description, Mode=OneWay}" Glyph="{x:Bind Glyph, Mode=OneWay}">
                                        <controls:SettingsCard.Action>
                                            <controls:ShortcutRecorder Item="{x:Bind}" />
                                        </controls:SettingsCard.Action>
                                    </controls:SettingsCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock
            Text="Hidden inputs aren't listed. Show them on the Monitors page to give them a shortcut."
            Style="{StaticResource DescriptionStyle}"
            Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
